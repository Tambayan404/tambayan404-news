{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "t404-news",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "t404-news",
			"database_id": "REPLACE_WITH_D1_ID",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"SITE_NAME": "Tambayan 404 News",
		"SITE_TZ": "Asia/Manila",
		"DISCORD_GUILD_ID": "REPLACE_WITH_GUILD_ID",
		"LOOKBACK_HOURS": "72",
		"SUBREQUEST_BUDGET": "40",
		"SKIP_BOT_AUTHORS": "true"
	}
	// Secrets (set with `wrangler secret put <NAME>`, or `.dev.vars` locally):
	//   DISCORD_BOT_TOKEN  - bot token with View Channels + Read Message History
	//   INGEST_SECRET      - shared secret for manually triggering POST /api/ingest
}
