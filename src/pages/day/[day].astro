---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import DayNav from '../../components/DayNav.astro';
import LinkList from '../../components/LinkList.astro';
import { adjacentDays, latestDay, linksForDay } from '../../lib/db';
import { dayOf, isValidDay } from '../../lib/time';

export const prerender = false;

const { day } = Astro.params;
if (!day || !isValidDay(day)) return new Response('Not found', { status: 404 });

const tz = env.SITE_TZ || 'UTC';
const today = dayOf(new Date(), tz);
if (day > today) return new Response('Not found', { status: 404 });

const [links, nav, latest] = await Promise.all([
  linksForDay(env.DB, day),
  adjacentDays(env.DB, day),
  latestDay(env.DB),
]);

// Past days rarely change (only reaction counts inside the lookback window), so cache harder.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=900');
---

<Layout title={day}>
  <DayNav day={day} prev={nav.prev} next={nav.next} isToday={day === today} count={links.length} />
  <LinkList links={links} emptyHint="No links were shared this day." latestDay={latest} />
</Layout>
