#!/usr/bin/env bash
# Prepares a fresh Amp orb: pinned pnpm, dependencies, local secrets template, local D1 schema and sample data.
# Must stay idempotent: it reruns on top of stale snapshots.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local name="$1"
  shift
  local start=$SECONDS
  echo "==> $name"
  "$@"
  echo "    $name took $((SECONDS - start))s"
}

ensure_pnpm() {
  local want
  want="$(node -p "require('./package.json').packageManager.split('@')[1]")"
  if [[ "$(pnpm --version 2>/dev/null || true)" != "$want" ]]; then
    corepack enable pnpm
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack prepare "pnpm@$want" --activate
  fi
  pnpm --version
}

copy_dev_vars() {
  # `wrangler types` (and so `pnpm build`/`pnpm dev`) needs .dev.vars to exist.
  if [[ ! -f .dev.vars ]]; then
    cp -- .dev.vars.example .dev.vars
  fi
}

step "pnpm" ensure_pnpm
step "pnpm install" pnpm install --frozen-lockfile --prefer-offline
step ".dev.vars" copy_dev_vars
step "wrangler types" pnpm --silent wrangler types
step "local D1 migrations" pnpm --silent db:migrate:local
# Replaces only the sample rows (guild_id 'seed-guild'), so reruns refresh them without touching other data.
step "local D1 seed" pnpm --silent db:seed:local
