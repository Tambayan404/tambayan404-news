{
  "name": "t404-news",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro check && astro build",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "astro": "astro",
    "dev:worker": "pnpm build && wrangler dev --test-scheduled",
    "cron:local": "curl -s http://localhost:8787/cdn-cgi/handler/scheduled",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "astro": "^7.3.2",
    "wrangler": "^4.131.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.4.1",
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,astro,json,jsonc,md,css}": "prettier --write"
  }
}
